{
  "globalDependencies": ["tsconfig.base.json", ".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "db:validate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "env": ["DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "db:generate"]
    },
    "test": {
      "dependsOn": ["db:generate"],
      "outputs": ["coverage/**"]
    },
    // Never cached: a cache hit would report success without querying the database.
    // No dependency on db:generate: these tests use `pg` directly, not the generated client.
    "test:integration": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "test:coverage": {
      "dependsOn": ["db:generate"],
      "outputs": ["coverage/**"]
    }
  }
}
