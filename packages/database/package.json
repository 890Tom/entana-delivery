{
  "name": "@entana/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "node seed/preflight/run-preflight.ts && node seed/index.ts",
    "db:reset-and-seed": "node seed/preflight/run-preflight.ts && node seed/index.ts --reset",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@entana/password-hash": "workspace:*",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "prisma": "7.10.0",
    "vitest": "^5.0.3"
  }
}
