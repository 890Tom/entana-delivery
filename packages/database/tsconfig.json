{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The seed runs with Node's own TypeScript support, which needs the .ts extension in imports.
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "seed",
    "tests",
    "prisma.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ]
}
