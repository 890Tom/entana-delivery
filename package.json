{
  "name": "entana-delivery",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:coverage:api": "turbo run test:coverage:merge --filter=@entana/api",
    "test:e2e": "turbo run test:e2e",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test:integration": "turbo run test:integration",
    "dev": "turbo run dev",
    "lint": "turbo run db:generate && eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:seed": "pnpm --filter @entana/database db:seed",
    "db:reset-and-seed": "pnpm --filter @entana/database db:reset-and-seed",
    "db:generate": "turbo run db:generate",
    "db:validate": "turbo run db:validate",
    "prepare": "husky",
    "lint:architecture": "depcruise packages apps --config dependency-cruiser.config.mjs",
    "knip": "knip"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --max-warnings 0"
  }
}
