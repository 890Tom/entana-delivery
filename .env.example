# Copy to .env and fill in. Never commit .env.
# Without NODE_ENV the API runs as production: no API documentation, JSON logs.
NODE_ENV=development
# API (apps/api). Every value is validated at startup: the API refuses to start if one is invalid.
# HOST: use 127.0.0.1 for local development, so the API is not exposed to the local network.
# Inside a container it must be 0.0.0.0, or the published port is unreachable, even though the
# container's own health check passes (that check runs inside the container).
# The image and the Compose service already set it explicitly: do not copy this file into a
# container environment as is.
HOST=127.0.0.1
PORT=3000
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# Number of reverse proxies in front of the API, or false (no proxy, the default). With one proxy
# (nginx, Caddy) set 1: the API then reads the client address that the proxy adds. A wrong value
# lets a client choose its own address. Never use true.
TRUST_PROXY=false
# Largest accepted JSON request body, in kilobytes.
BODY_LIMIT_KB=100
# Serves /api/docs. Off by default when NODE_ENV=production.
SWAGGER_ENABLED=true
# Browser origins allowed to call the API, separated by commas (scheme, host, port; no path, no
# wildcard). Empty: no cross-origin call is allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Browser origins of the administration, separated by commas (same form as CORS_ORIGINS). A request
# that changes something under /api/v1/admin must come from one of them. Required in production;
# without it, development uses http://localhost:5173.
ADMIN_ALLOWED_ORIGINS=http://localhost:5173
# Secure flag (and __Host- prefix) of the session cookie of the administration. On in production,
# off otherwise: set it to true behind HTTPS only. Browsers refuse a Secure cookie over plain HTTP,
# except on localhost.
# ADMIN_COOKIE_SECURE=false
# Instance configuration file (shop name, locale, time zone, phone country code, branding): see
# examples/demo/instance.config.yaml. Required in production. Without this variable, development
# uses the demo file.
# INSTANCE_CONFIG_PATH=./instance.config.yaml
# Folder of the media (branding/ and products/), served read-only under /media. Absolute path.
# Required in production; without it, development uses ./media at the repository root (ignored by git).
# MEDIA_ROOT=/absolute/path/to/media
# Docker Compose (profile app): the instance configuration file mounted in the container. The demo
# file is used when unset.
# INSTANCE_CONFIG_FILE=./instance.config.yaml
# PostgreSQL (docker compose). Choose your own password.
# DATABASE_URL repeats the user, password, database and port below: keep them in sync.
# Special characters in the password must be percent-encoded inside DATABASE_URL (@ becomes %40,
# / becomes %2F, : becomes %3A). The value must contain no space and no trailing newline.
# DATABASE_URL is required: the API refuses to start without it.
POSTGRES_USER=entana
POSTGRES_PASSWORD=change-me-choose-a-database-password
POSTGRES_DB=entana
POSTGRES_PORT=5433
DATABASE_URL=postgresql://entana:change-me-choose-a-database-password@localhost:5433/entana
JWT_ACCESS_SECRET=change-me-generate-a-long-random-value
JWT_REFRESH_SECRET=change-me-generate-another-long-random-value
INITIAL_ADMIN_USERNAME=admin
# The initial admin password is generated and printed by the seed script.
# Never put ALLOW_DESTRUCTIVE_SEED or ALLOW_SEED_NON_LOCAL in this file (the seed then refuses to run):
# pass them on the command line, see packages/database/README.md.
SENTRY_DSN=
