{
  "name": "@entana/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "pnpm test:coverage:unit",
    "test:coverage:unit": "COVERAGE_PART=1 vitest run --reporter=default --reporter=blob --outputFile.blob=.vitest-reports/blobs/unit.json --coverage --coverage.reportsDirectory=.vitest-reports/coverage-unit",
    "test:coverage:integration": "COVERAGE_PART=1 vitest run --config vitest.integration.config.ts --reporter=default --reporter=blob --outputFile.blob=.vitest-reports/blobs/integration.json --coverage --coverage.reportsDirectory=.vitest-reports/coverage-integration",
    "test:coverage:merge": "vitest run --merge-reports=.vitest-reports/blobs --coverage",
    "test:e2e": "vitest run tests/e2e",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "admin:upsert": "node --env-file-if-exists=../../.env dist/cli/admin-upsert.js"
  },
  "dependencies": {
    "@entana/contracts": "workspace:*",
    "@entana/database": "workspace:*",
    "@entana/password-hash": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "cron": "4.4.0",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
