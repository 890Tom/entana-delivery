#!/bin/sh
# Blocks commits that contain secrets. Enable with:
#   git config core.hooksPath scripts/hooks
# Requires gitleaks: https://github.com/gitleaks/gitleaks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed. Install it (for example: brew install gitleaks) before committing." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --verbose --config .gitleaks.toml
