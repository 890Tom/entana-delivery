# Environment of the production stack (deploy/docker-compose.prod.yml). Copy to deploy/.env on the
# server, fill in, then `chmod 600 deploy/.env`. Never commit deploy/.env. Every value below is
# fake.

# Name of the customer site. Required. Its DNS record must point to the server.
CLIENT_HOST=shop.example.com
# Name of the administration site, another origin than the customer site. Required.
ADMIN_HOST=admin.shop.example.com

# PostgreSQL role and database, created on the first start.
POSTGRES_USER=entana
POSTGRES_DB=entana
# Password of that role. Required. Only letters, digits and - . _ ~ : it goes into a connection URL
# that is not percent-encoded. Generate it with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24

# Shop description file on the server, mounted read-only into the API. Required. Copy
# examples/demo/instance.config.yaml there and adapt it to the shop; keep it out of the repository.
INSTANCE_CONFIG_FILE=/opt/entana/instance.config.yaml

# Branding of the shop: absolute path of a folder created on the server, outside the repository,
# holding client/public/... and admin/public/... (deploy/README.md#branding-optional). Default: none,
# the demo icons, manifest and themes. Rebuild with `up -d --build` after changing the folder.
# OVERRIDES_DIR=/opt/entana/overrides

# Only when HTTPS is published on a port other than 443: the browser origin of the administration
# then includes the port (https://admin.shop.example.com:8443). Default: https://<ADMIN_HOST>.
# ADMIN_ALLOWED_ORIGINS=https://admin.shop.example.com:8443

# Ports published on the host for caddy. Default 80 and 443; certificates need both reachable.
# HTTP_PORT=80
# HTTPS_PORT=443

# Log level of the API: fatal, error, warn, info, debug, trace or silent. Default info.
# LOG_LEVEL=info
